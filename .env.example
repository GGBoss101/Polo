# Copy to .env and fill in what you use: cp .env.example .env
# Run: uv run --env-file .env uvicorn polo_extract.api:app --reload --app-dir extraction
# Setup steps for every key: docs/SETUP.md

# ---- Model used for every scan unless you pick another in dev mode ----
# Claude: claude-opus-5-5 | claude-sonnet-5-5 | claude-haiku-5-5
# Others: ollama:<model>, gemini:<model>, groq:<model>, openrouter:<model>
POLO_MODEL=claude-opus-5-5
# Claude only: low | medium | high
POLO_EFFORT=low

# 1 shows the model picker and "compare all" on the page. Set 0 before testers use it.
POLO_DEV=1

# ---- Anthropic (paid, prepaid credits) ----
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---- Ollama (free, runs on your Mac, no key) ----
# Install the Ollama app, then e.g.: ollama pull qwen2.5vl:7b
OLLAMA_URL=http://localhost:11434

# ---- Google Gemini (free tier, prompts may be used by Google: don't send testers' photos) ----
# https://aistudio.google.com -> Get API key
GEMINI_API_KEY=
# Comma-separated; check the current free models in AI Studio
GEMINI_MODELS=gemini-3.8-flash

# ---- Groq (free tier, rate limited) ----
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODELS=qwen/qwen3.8-27b

# ---- OpenRouter (free ":free" models, rate limited) ----
# https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-super-vl:free

# ---- Service settings ----
# Max scans per IP per hour, protects your API spend
POLO_RATE_LIMIT_PER_HOUR=40
# 1 = decode QR codes and read linked event pages (never Instagram/Facebook/TikTok)
POLO_FETCH_LINKS=1
# Seconds before giving up on Gemini, Groq or OpenRouter
POLO_HOSTED_TIMEOUT=60
# 1 keeps uploaded photos in the log dir for labeling (tell testers first)
POLO_SAVE_UPLOADS=0
# Where captures.jsonl and activity.jsonl go (default: extraction/logs)
# POLO_LOG_DIR=
